{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Extract frames: sample clip",
      "type": "debugpy",
      "request": "launch",
      "module": "classroom_analysis.cli",
      "args": ["extract-frames", "examples/sample_clip.mp4", "--config", "configs/frame_extraction.yaml"],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
